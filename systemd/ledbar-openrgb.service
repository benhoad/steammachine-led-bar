[Unit]
Description=Headless OpenRGB SDK server for ledbar
Documentation=https://openrgb.org/

[Service]
Type=simple
ExecStart=%h/.local/share/ledbar/bin/ledbar-openrgb-server
Restart=on-failure
RestartSec=5
# Headless OpenRGB (--server without --gui) never creates a Qt window, so no display is needed.

[Install]
WantedBy=default.target
